# DATABASE_URL must use the asyncpg driver scheme
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/reacta
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
MEDIA_ROOT=/var/reacta/media
STORAGE_BACKEND=disk
REDIS_URL=redis://localhost:6379
WHISPER_MODEL=base

# Required when STORAGE_BACKEND=s3 (Backblaze B2)
# B2_ENDPOINT_URL=https://s3.<region>.backblazeb2.com
# B2_ACCESS_KEY_ID=your-key-id
# B2_SECRET_ACCESS_KEY=your-application-key
# B2_BUCKET_NAME=your-bucket-name
